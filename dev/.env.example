# Optional local overrides for the Docker Compose dev stacks.
# Copy this file to dev/.env, then adjust values as needed.

# Memory
SERVER_MEMORY=2G
PROXY_MEMORY=512M

# Minecraft/server versions
# Bukkit-compatible stacks default to the same version used by the Gradle runServer task.
PAPER_MC_VERSION=1.21.6
SPIGOT_MC_VERSION=1.21.6
FOLIA_MC_VERSION=1.21.6
PROXY_BACKEND_MC_VERSION=1.21.6

# Fabric is pinned to the versions declared in gradle/libs.versions.toml.
FABRIC_MC_VERSION=1.21.1
FABRIC_LOADER_VERSION=0.19.2

# Host ports. These are intentionally unique so multiple stacks can run at once.
PAPER_PORT=25565
SPIGOT_PORT=25566
FOLIA_PORT=25567
FABRIC_PORT=25568
VELOCITY_PORT=25569
BUNGEE_PORT=25570
WATERFALL_PORT=25571

# MCMetrics/Hoglin config. These are passed as JVM system properties so no
# secret-bearing config.toml files need to be committed.
MCMETRICS_API_SERVER=https://api.mcmetrics.net
MCMETRICS_SERVER_KEY=
MCMETRICS_PAPER_INSTANCE_ID=paper-dev
MCMETRICS_SPIGOT_INSTANCE_ID=spigot-dev
MCMETRICS_FOLIA_INSTANCE_ID=folia-dev
MCMETRICS_FABRIC_INSTANCE_ID=fabric-dev
MCMETRICS_VELOCITY_INSTANCE_ID=velocity-dev
MCMETRICS_BUNGEE_INSTANCE_ID=bungee-dev
MCMETRICS_WATERFALL_INSTANCE_ID=waterfall-dev
